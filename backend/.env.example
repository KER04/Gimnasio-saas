DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=
DB_HOST=
DB_PORT=
DB_APP_USER=
DB_APP_PASSWORD=
DB_DDL_USER=
DB_DDL_PASSWORD=

# Opcional. Si se define, el throttling de login (y cualquier otro uso del
# caché por defecto) usa Redis en vez de LocMemCache -- OBLIGATORIO en
# producción con más de un worker/réplica, porque LocMemCache es por proceso
# (ver comentario en config/settings/base.py). Ejemplo: redis://127.0.0.1:6379/1
REDIS_URL=
